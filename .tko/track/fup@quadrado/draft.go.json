            "content": "package main\nimport \"fmt\"\nfunc main() {\n    var nums int\n    var matriz[3][3]int\n\n    for i:=range matriz{\n        for j:= range matriz{\n            fmt.Scan(&nums)\n            matriz[i][j]=nums\n        }\n    }\n        var l[3]int\n        var c[3]int\n        dp:=0\n        ds:=0\n\n    for i:=0; i<3; i++{ /*colunas*/\n        for j:=0; j<3; j++{\n            c[j]+=matriz[i][j]\n        }\n    }\n    for j:=0; j<3; j++{ /*linhas*/\n        for i:=0; i<3; i++{\n            l[i]+=matriz[i][j]\n        }\n    }\n    for i:=0; i<3; i++{ /*diagonal principal*/\n        for j:=0; j<3; j++{\n            if i==j{\n                dp+=matriz[i][j]\n            }\n        }\n    }\n    for i:=0; i<3; i++{\n        ds+=matriz[i][3-1-i]\n    }\n    \n    if l[0] != l[1] && l[1] != l[2] {\n        fmt.Println(\"nao\")\n    } else if c[0] != c[1] && c[1] != c[2] {\n        fmt.Println(\"nao\")\n    } else if dp != ds {\n        fmt.Println(\"nao\")\n    } else {\n        fmt.Println(\"sim\")\n    }   \n    \n    //fmt.Println(ds)\n\n}\n",
